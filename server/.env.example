# ── Serveur ─────────────────────────────────────────────
PORT=8787
# URL publique (Cloudflare Tunnel), sans / final. Doit être identique à OLY_SERVER_URL au build du client.
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data

# ── Discord OAuth2 (https://discord.com/developers/applications) ──
# Redirect à ajouter dans OAuth2 → Redirects : <PUBLIC_URL>/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs Discord séparés par des virgules. Vide = tout le monde peut se connecter.
ALLOWED_USER_IDS=
ADMIN_USER_IDS=

# ── Stockage ────────────────────────────────────────────
MAX_FILE_SIZE_MB=2048
USER_QUOTA_MB=5120
GLOBAL_MAX_GB=200
MIN_FREE_DISK_GB=10
FILE_TTL_DAYS=30
# ≤ 95 : Cloudflare Tunnel (gratuit) refuse les requêtes > 100 Mo
CHUNK_SIZE_MB=50
MAX_PROFILE_IMAGE_MB=15
STALE_UPLOAD_HOURS=24

# ── Production (docker compose --profile prod) ──────────
TUNNEL_TOKEN=
